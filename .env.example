# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Supabase > Project Settings > API (or "Data API")
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Anthropic Console > API keys. Server only.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Check the current model names at docs.claude.com.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. Per-user monthly cap on AI credits (drafts and, later, test runs).
CREDIT_CAP_MONTHLY=100
